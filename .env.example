# =====================================================================
# CẤU HÌNH BẢO MẬT GỌI CLOUD AI GATEWAY (LLM & EMBEDDING)
# Lưu ý: Tuyệt đối không commit file .env chứa API Key thật lên Git!
# Sao chép file này thành '.env' và điền API Key bí mật của bạn.
# =====================================================================

# 1. Cấu hình Enterprise Cloud AI Gateway (OpenAI-Compatible)
CLOUD_LLM_API_KEY=your_secret_api_key_here
CLOUD_LLM_BASE_URL=https://api.your-cloud-gateway.com/v1
CLOUD_LLM_MODEL=DeepSeek-V3

# 2. Cấu hình Mô hình Embedding Nơ-ron (1024 chiều)
CLOUD_EMBEDDING_API_KEY=your_secret_api_key_here
CLOUD_EMBEDDING_BASE_URL=https://api.your-cloud-gateway.com/v1
CLOUD_EMBEDDING_MODEL=Vietnamese_Embedding

# 3. Vector Database Persistent Storage (Tùy chọn)
CHROMA_PERSIST_DIR=./data/chroma_db
QDRANT_LOCATION=:memory:
