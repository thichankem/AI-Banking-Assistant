{
  "name": "rate_agent_csat",
  "display_name": "Đánh Giá Mức Độ Hài Lòng CSAT",
  "category": "OPERATIONAL",
  "description": "Ghi nhận điểm đánh giá độ hài lòng CSAT từ 1 đến 5 sao của khách hàng sau cuộc hội thoại.",
  "parameters": {
    "type": "object",
    "properties": {
      "rating_score": {
        "type": "integer",
        "description": "Điểm đánh giá từ 1 đến 5",
        "minimum": 1,
        "maximum": 5
      },
      "user_message": {
        "type": "string",
        "default": "",
        "description": "Ý kiến đóng góp thêm của khách hàng"
      },
      "channel": {
        "type": "string",
        "default": "web",
        "description": "Kênh tương tác của khách hàng"
      }
    },
    "required": ["rating_score"]
  },
  "returns": {
    "type": "object",
    "properties": {
      "status": {"type": "string"},
      "rating_score": {"type": "integer"},
      "comment": {"type": "string"},
      "channel": {"type": "string"},
      "final_answer": {"type": "string"}
    }
  },
  "handler": {
    "module": "agent_banking.tools.banking_api_tools",
    "function": "rate_agent_csat"
  }
}
