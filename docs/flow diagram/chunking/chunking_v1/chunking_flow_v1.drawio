        <mxCell id="docx_table_head" value="&lt;b&gt;Table Atomicity &amp;amp; Header 2 Tầng&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#9D174D;background:#FDF2F8;padding:1px 3px;border-radius:3px;'&gt;📄 docx_chunker/docx_chunker.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Phát hiện bảng 2 tầng header, tuyến tính hóa: Hàng X: Cột_i: Giá_trị&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FDF2F8;strokeColor=#DB2777;fontColor=#9D174D;fontSize=9.5;shadow=1;align=center;">
