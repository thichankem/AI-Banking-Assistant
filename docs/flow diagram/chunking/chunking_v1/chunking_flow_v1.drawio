        <mxCell id="end_node" value="&lt;b&gt;SẴN SÀNG TRUY VẤN (RRF)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;font-weight:normal;'&gt;Hệ thống sẵn sàng nhận truy vấn &amp;amp; truy xuất lai ghép qua &lt;b&gt;Reciprocal Rank Fusion (RRF k=60)&lt;/b&gt;&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;fontStyle=1;fontSize=11;shadow=1;align=center;">
