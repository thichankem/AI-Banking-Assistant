        <!-- ==================== LUỒNG 2: DOCX CHUNKER ==================== -->
        <mxCell id="lane_docx" value="LUỒNG 2: DOCX CHUNKER (DOCUMENT LAYOUT AST &amp; TABLE ATOMICITY)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;swimlane;startSize=26;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1.5;fontColor=#5B21B6;fontSize=12;fontStyle=1;collapsible=0;shadow=1;">
          <mxGeometry x="705" y="255" width="595" height="675" as="geometry"/>
        </mxCell>

        <mxCell id="docx_open" value="&lt;b&gt;Mở tệp Word DOCX (python-docx)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;Duyệt Body DOM tuần tự theo thứ tự hiển thị XML&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=11;shadow=1;align=center;">
          <mxGeometry x="755" y="295" width="495" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="docx_branch" value="&lt;b&gt;Loại Khối Element?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;&amp;lt;w:p&amp;gt; hay &amp;lt;w:tbl&amp;gt;?&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rhombus;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=10;fontStyle=1;shadow=1;align=center;">
          <mxGeometry x="920" y="360" width="165" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="docx_p_head" value="&lt;b&gt;Heading Hierarchy (AST Cây Phân Cấp)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Duyệt Word Styles chuẩn + Heuristic in đậm (run.bold) &amp;amp; cách đoạn&lt;br/&gt;Tự động cập nhật stack active_headers cấp 1..4&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#3730A3;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="755" y="435" width="235" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="docx_table_head" value="&lt;b&gt;Table Atomicity &amp; Dual-Representation&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Trích xuất toàn vẹn bảng biểu &amp;lt;tbl&amp;gt;&lt;br/&gt;Tuyến tính hóa: Hàng X: Cột_i: Giá_trị&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FDF2F8;strokeColor=#DB2777;fontColor=#9D174D;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="1015" y="435" width="235" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="docx_p_body" value="&lt;b&gt;List &amp; Paragraph Grouping&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Gom danh sách đạn (bullets, numbers) với đoạn dẫn nhập&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="755" y="510" width="235" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="docx_table_chunk" value="&lt;b&gt;Batch Table Row Chunking&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Đóng gói khối bảng biểu nguyên tử kèm header cột&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="1015" y="510" width="235" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="docx_anti_frag" value="&lt;b&gt;Cơ chế Chống phân mảnh vụn (Section-Length-Aware Anti-Fragmentation)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;Loại bỏ flush sớm; tự động gộp các tiểu mục còi cọc (&amp;lt; 120 từ) &amp;rarr; Đưa về Dải Vàng 150 - 450 từ&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=11;shadow=1;align=center;">
