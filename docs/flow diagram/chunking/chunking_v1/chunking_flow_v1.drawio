        <mxCell id="unify_engine" value="&lt;b style='font-size:13px;'&gt;UNIFIED CONTEXT INJECTION &amp;amp; VALIDATION ENGINE&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;&amp;bull; Gắn tiền tố Breadcrumb 100% chunks (Preservation) &amp;bull; Chuẩn hóa Unicode NFC &amp;bull; Lọc sạch chunk rỗng &amp;bull; Tính toán char_length, word_count, syllable_count&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=11;fontStyle=1;shadow=1;align=center;">
