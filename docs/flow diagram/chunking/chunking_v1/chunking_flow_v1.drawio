        <!-- ==================== LUỒNG 1: PDF CHUNKER ==================== -->
        <mxCell id="lane_pdf" value="LUỒNG 1: PDF CHUNKER (OCR HÌNH HỌC &amp; TÁI TẠO BẢN SCAN)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;swimlane;startSize=26;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E40AF;fontSize=12;fontStyle=1;collapsible=0;shadow=1;">
          <mxGeometry x="60" y="275" width="620" height="715" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_open" value="&lt;b&gt;Mở Tệp PDF &amp;amp; Phân Tích Layout&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9.5px;color:#1D4ED8;background:#DBEAFE;padding:1px 4px;border-radius:3px;'&gt;📄 pdf_chunker/pdf_chunker.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;'&gt;Dùng PyMuPDF (fitz) duyệt từng trang, pdfplumber tìm bảng find_tables()&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=11;shadow=1;align=center;">
          <mxGeometry x="105" y="315" width="530" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_check_scan" value="&lt;b&gt;Kiểm Tra Trang Scan?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#B91C1C;background:#FEE2E2;padding:1px 3px;border-radius:3px;'&gt;📄 pdf_chunker/scan_detector.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:8.5px;color:#7F1D1D;'&gt;img_area &amp;ge; 40% &amp;amp; words &amp;lt; 30 HOẶC lỗi font&lt;br/&gt;&lt;i&gt;Test: unit_test/test_scan_detection.py (100% OK)&lt;/i&gt;&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rhombus;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=9.5;fontStyle=1;shadow=1;align=center;">
          <mxGeometry x="250" y="375" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- Nhánh Scan PDF chuyên sâu -->
        <mxCell id="pdf_scan_pre" value="&lt;b&gt;Tiền Xử Lý Scan 300 DPI &amp;amp; Lọc Mộc Đỏ&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#B91C1C;background:#FEE2E2;padding:1px 3px;border-radius:3px;'&gt;📄 pdf_chunker/ocr_extractor.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Deskew góc nghiêng &amp;bull; Lọc dấu mộc đỏ HSV OpenCV (Hue 0-10, 170-180)&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="105" y="455" width="270" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_ocr_box" value="&lt;b&gt;RapidOCR ONNX &amp;amp; Sắp Xếp Reading Order&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#B91C1C;background:#FEE2E2;padding:1px 3px;border-radius:3px;'&gt;📄 pdf_chunker/ocr_extractor.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Lưu [box, text, score] &amp;bull; Phân đoạn 2 cột, loại bỏ header/footer 8% lặp lại&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="105" y="515" width="270" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_scan_rec" value="&lt;b&gt;Dự Đoán Cấp Bậc Hình Học (0% Regex)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#92400E;background:#FEF3C7;padding:1px 3px;border-radius:3px;'&gt;📄 pdf_chunker/ocr_layout_predictor.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;rel_h (h/median_h) &amp;bull; gap_before &amp;bull; Căn giữa trang &amp;bull; Thụt lề Khoản/Điểm (&amp;Delta;x)&lt;br/&gt;TOCVerifier: Đối chiếu Mục lục Unicode NFKD chuẩn hóa&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=9.5;shadow=1;align=center;">
          <mxGeometry x="105" y="575" width="270" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_tracker" value="&lt;b&gt;Tái Tạo Cấu Trúc Scan (State Machine)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#1E40AF;background:#DBEAFE;padding:1px 3px;border-radius:3px;'&gt;📄 pdf_chunker/scan_structure_reconstructor.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;BreadcrumbTracker: title &amp;gt; h1 &amp;gt; h2 &amp;gt; h3 &amp;bull; indent_level 1-2&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=9.5;shadow=1;align=center;">
          <mxGeometry x="105" y="658" width="270" height="48" as="geometry"/>
        </mxCell>

        <!-- Nhánh Digital PDF & Tables -->
        <mxCell id="pdf_digital_pass" value="&lt;b&gt;Trích Xuất Bảng (pdf_table)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#065F46;background:#D1FAE5;padding:1px 3px;border-radius:3px;'&gt;📄 pdf_chunker/pdf_chunker.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;find_tables() tuyến tính hóa từng hàng&lt;br/&gt;Lặp lại Header cột ở mỗi batch chunk&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=9.5;shadow=1;align=center;">
          <mxGeometry x="400" y="455" width="235" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_digital_stream" value="&lt;b&gt;Ghép Luồng Văn Bản Số (Cross-Page)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#065F46;background:#D1FAE5;padding:1px 3px;border-radius:3px;'&gt;📄 pdf_chunker/pdf_chunker.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Phát hiện Heading Điều/Chương &amp;bull; Tách câu ngân hàng an toàn (split_sentences_banking)&lt;br/&gt;Bảo toàn trang span: page_start &amp;rarr; page_end&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=9.5;shadow=1;align=center;">
          <mxGeometry x="400" y="535" width="235" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_nlp_res" value="&lt;b&gt;Xử Lý Ngôn Ngữ &amp;amp; Chuẩn Hóa Văn Bản&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#6B21A8;background:#F3E8FF;padding:1px 3px;border-radius:3px;'&gt;📄 unified_chunk/canonical_resolver.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Làm sạch dấu nối (dehyphenate), kiểm tra tiếng Việt hợp lệ, đếm âm tiết&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;fontSize=9.5;shadow=1;align=center;">
          <mxGeometry x="400" y="625" width="235" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_bc" value="&lt;b&gt;Gắn Tiền Tố Breadcrumb &amp;amp; Tên Tài Liệu (Ref)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:10px;color:#1E40AF;'&gt;[Breadcrumbs: file.pdf &amp;gt; Chương I &amp;gt; Điều 1]&lt;br/&gt;[Ref: file.pdf]&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=10.5;shadow=1;align=center;">
          <mxGeometry x="105" y="730" width="530" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_out" value="&lt;b&gt;Xuất PDF Chunks Chuẩn Hóa (Schema Mới: Có ref, Không format)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;chunk_type: &lt;b&gt;pdf_text&lt;/b&gt; | &lt;b&gt;pdf_ocr_scan&lt;/b&gt; | &lt;b&gt;pdf_table&lt;/b&gt; (Bảo toàn 100% Breadcrumb, ref = file.pdf)&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=11;fontStyle=1;shadow=1;align=center;">
          <mxGeometry x="105" y="805" width="530" height="45" as="geometry"/>
        </mxCell>

