        <mxCell id="title_banner" value="&lt;b style='font-size:16px;color:#38BDF8;'&gt;KIẾN TRÚC &amp;amp; LUỒNG DỮ LIỆU PHÂN ĐOẠN TÀI LIỆU (DLA CHUNKING PIPELINE)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;AI Banking Assistant &amp;bull; Modular Architecture: pdf_chunker/, docx_chunker/, unified_chunk/ &amp;bull; Hiển Thị File Python Thực Thi&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;shape=rectangle;rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontSize=14;align=center;shadow=1;">
