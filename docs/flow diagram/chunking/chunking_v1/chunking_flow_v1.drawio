        <mxCell id="standard_schema" value="&lt;b&gt;CẤU TRÚC SCHEMA CHUẨN MỚI CỦA MỖI CHUNK (KHÔNG CÓ FORMAT, REF LÀ TÊN TÀI LIỆU):&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:10px;color:#0F172A;line-height:1.6;'&gt;{&lt;br/&gt;  &quot;chunk_id&quot;: &quot;Quy_che_eKYC_docx_c0&quot;,&lt;br/&gt;  &quot;source&quot;: &quot;Quy_che_eKYC.docx&quot;,&lt;br/&gt;  &quot;ref&quot;: &quot;Quy_che_eKYC.docx&quot;,  &lt;i style='color:#059669;'&gt;// Tên tài liệu chứa chunk&lt;/i&gt;&lt;br/&gt;  &quot;breadcrumb&quot;: &quot;Quy chế eKYC &amp;gt; Chương II &amp;gt; Điều 12 &amp;gt; Hạn mức&quot;,&lt;br/&gt;  &quot;chunk_type&quot;: &quot;docx_text&quot; | &quot;docx_table&quot; | &quot;pdf_text&quot; | &quot;pdf_table&quot; | &quot;pdf_ocr_scan&quot;,&lt;br/&gt;  &quot;content&quot;: &quot;[Breadcrumbs: ...] \n [Ref: Quy_che_eKYC.docx] \n Nội dung văn bản...&quot;,&lt;br/&gt;  &quot;word_count&quot;: 245,  &quot;char_length&quot;: 1280,  &quot;syllable_count&quot;: 310&lt;br/&gt;}&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontSize=10;shadow=1;align=left;spacingLeft=12;">
