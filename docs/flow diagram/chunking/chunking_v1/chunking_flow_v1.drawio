        <mxCell id="standard_schema" value="&lt;b&gt;CẤU TRÚC METADATA CHUẨN CỦA MỖI CHUNK (UNIFIED CHUNK SCHEMA):&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:10px;color:#0F172A;line-height:1.5;'&gt;&amp;bull; &lt;b&gt;chunk_id:&lt;/b&gt; &quot;vcb_ekyc_docx_c0&quot; | &lt;b&gt;format:&lt;/b&gt; &quot;docx&quot; | &quot;pdf&quot; | &lt;b&gt;chunk_type:&lt;/b&gt; &quot;docx_text&quot; | &quot;docx_table&quot; | &quot;pdf_text&quot; | &quot;pdf_ocr_scan&quot;&lt;br/&gt;&amp;bull; &lt;b&gt;breadcrumb:&lt;/b&gt; &quot;Quy chế eKYC &amp;gt; Chương II &amp;gt; Điều 12 &amp;gt; Hạn mức giao dịch&quot; | &lt;b&gt;indent_level:&lt;/b&gt; 1 (Khoản) | 2 (Điểm)&lt;br/&gt;&amp;bull; &lt;b&gt;content:&lt;/b&gt; &quot;[Breadcrumbs...] [Pháp lý...] Nội dung đoạn văn bản hoặc bảng ma trận số liệu...&quot; | &lt;b&gt;word_count:&lt;/b&gt; 235&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontSize=10;shadow=1;align=left;spacingLeft=12;">
