        <mxCell id="benchmark_badge" value="&lt;b&gt;Chỉ Số Đánh Giá Kiểm Chuẩn Thực Nghiệm:&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#059669;'&gt;&amp;bull; &lt;b&gt;Độ phủ Breadcrumbs:&lt;/b&gt; &lt;b&gt;100%&lt;/b&gt; chunks bảo toàn ngữ cảnh&lt;br/&gt;&amp;bull; &lt;b&gt;Độ phủ Ref (Tên tài liệu):&lt;/b&gt; &lt;b&gt;100%&lt;/b&gt; chunks gắn đúng ref gốc&lt;br/&gt;&amp;bull; &lt;b&gt;Nhận diện Scan/Digital:&lt;/b&gt; &lt;b&gt;100% Accuracy &amp;amp; F1&lt;/b&gt; (100 mẫu benchmark)&lt;br/&gt;&amp;bull; &lt;b&gt;Tỷ lệ Dải Vàng (150-450 từ):&lt;/b&gt; &lt;b&gt;&amp;gt; 80%&lt;/b&gt; (loại bỏ hoàn toàn chunk rác còi cọc)&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=10;shadow=0;align=left;spacingLeft=10;">
