        <mxCell id="node_pipeline" value="&lt;b&gt;ChunkingPipeline (API Điều Phối Tổng)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:10px;color:#1D4ED8;background:#DBEAFE;padding:1px 4px;border-radius:3px;'&gt;📄 rag_banking/chunking/pipeline.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#475569;'&gt;Khởi tạo và cấu hình tham số DLA Engine cho toàn bộ pipeline&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=11;fontStyle=1;shadow=1;align=center;">
