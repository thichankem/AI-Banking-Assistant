        <mxCell id="node_router" value="&lt;b&gt;LayoutAwareChunker (DLA Engine Router)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:10px;color:#047857;background:#D1FAE5;padding:1px 4px;border-radius:3px;'&gt;📄 unified_chunk/layout_aware_chunker.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#475569;'&gt;Định tuyến theo đuôi tệp: .docx &amp;rarr; DOCX | .pdf &amp;rarr; PDF&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontSize=11;fontStyle=1;shadow=1;align=center;">
