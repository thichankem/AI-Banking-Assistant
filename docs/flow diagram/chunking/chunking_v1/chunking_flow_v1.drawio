        <mxCell id="e_dual_dense" value="text (Dense)" edge="1" parent="1" source="dual_indexing" target="dense_index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=1.5;endArrow=classic;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;">
