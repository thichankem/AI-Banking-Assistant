        <mxCell id="lane_storage" value="PHASE 4: XUẤT LƯU TRỮ ARTIFACTS &amp; BÀN GIAO TIẾP NHẬN HYBRID RAG DUAL INDEXING" vertex="1" parent="1" style="html=1;whiteSpace=wrap;swimlane;startSize=26;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;fontStyle=1;collapsible=0;shadow=1;">
