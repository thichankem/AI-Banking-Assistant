  <diagram id="diagram-chunking-rag-v1" name="DLA Chunking Pipeline Flow v1">
    <mxGraphModel dx="1400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1480" background="#F8FAFC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITLE BANNER -->
        <mxCell id="title_banner" value="&lt;b style='font-size:16px;color:#38BDF8;'&gt;HỆ THỐNG PHÂN ĐOẠN TÀI LIỆU NHẬN THỨC BỐ CỤC (DLA CHUNKING PIPELINE V1)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;AI Banking Assistant &amp;bull; Phân Cấp Thuần Túy Hình Học OCR (0% Regex) &amp;amp; DOCX (Layout AST &amp;amp; Section-Length-Aware)&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;shape=rectangle;rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontSize=14;align=center;shadow=1;">
          <mxGeometry x="60" y="20" width="1240" height="60" as="geometry"/>
        </mxCell>

        <!-- PHASE 1: INGESTION & ROUTER -->
        <mxCell id="lane_ingest" value="PHASE 1: ĐẦU VÀO ĐA ĐỊNH DẠNG &amp; BỘ ĐIỀU PHỐI ĐỊNH TUYẾN (MULTI-FORMAT ROUTER)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;swimlane;startSize=26;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;fontStyle=1;collapsible=0;shadow=1;">
          <mxGeometry x="60" y="95" width="1240" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="start_node" value="Bắt đầu" vertex="1" parent="1" style="html=1;whiteSpace=wrap;ellipse;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;fontStyle=1;fontSize=12;shadow=1;align=center;">
          <mxGeometry x="85" y="145" width="85" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="node_input_docs" value="&lt;b&gt;Kho Tài Liệu Ngân Hàng Mục Tiêu&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;Tệp Word .docx: Quy chế eKYC, Điều kiện điều khoản&lt;br/&gt;Tệp PDF .pdf: Báo cáo số, Bản scan mộc đỏ, Văn bản pháp quy&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;shadow=1;align=center;">
          <mxGeometry x="195" y="135" width="295" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="node_router" value="&lt;b&gt;LayoutAwareChunker (DLA Engine)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;Phân tích phần mở rộng tệp &amp;amp; điều phối 2 luồng cốt lõi&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=12;fontStyle=1;shadow=1;align=center;">
          <mxGeometry x="540" y="135" width="285" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="node_config_badge" value="&lt;b&gt;Thông số Cấu hình DLA Chuẩn:&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;&amp;bull; &lt;b&gt;max_chunk_size&lt;/b&gt; = 800 ký tự | &lt;b&gt;chunk_overlap&lt;/b&gt; = 100 ký tự&lt;br/&gt;&amp;bull; &lt;b&gt;min_section_size&lt;/b&gt; = 120 từ | &lt;b&gt;scanned_threshold&lt;/b&gt; = 40 ký tự&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#334155;fontSize=10;shadow=0;align=left;spacingLeft=10;">
          <mxGeometry x="870" y="135" width="410" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e_start_input" value="" edge="1" parent="1" source="start_node" target="node_input_docs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=1.5;endArrow=classic;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_input_router" value="tải tài liệu" edge="1" parent="1" source="node_input_docs" target="node_router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=1.5;endArrow=classic;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PHASE 2: TWO CORE SWIMLANES (PDF & DOCX) -->
        
        <!-- ==================== LUỒNG 1: PDF CHUNKER ==================== -->
        <mxCell id="lane_pdf" value="LUỒNG 1: PDF CHUNKER (OCR GEOMETRIC DLA &amp; ADVANCED SCAN RECONSTRUCTION)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;swimlane;startSize=26;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E40AF;fontSize=12;fontStyle=1;collapsible=0;shadow=1;">
          <mxGeometry x="60" y="255" width="595" height="675" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_open" value="&lt;b&gt;Mở tệp PDF (PyMuPDF &amp;amp; pdfplumber)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;find_tables() dò bảng biểu &amp;amp; Duyệt tuần tự các trang&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=11;shadow=1;align=center;">
          <mxGeometry x="110" y="295" width="495" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_check_scan" value="&lt;b&gt;Bản Scan?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;img_area &amp;gt; 40% HOẶC lỗi font&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rhombus;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=10;fontStyle=1;shadow=1;align=center;">
          <mxGeometry x="260" y="345" width="195" height="46" as="geometry"/>
        </mxCell>

        <!-- Nhánh Scan PDF chuyên sâu -->
        <mxCell id="pdf_scan_pre" value="&lt;b&gt;Tiền xử lý Scan Nâng cao (300 DPI, Deskew &amp;amp; Lọc Mộc Đỏ)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Render 300 DPI &amp;bull; Deskew Otsu/minAreaRect &amp;bull; Lọc mộc đỏ HSV OpenCV&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="110" y="405" width="290" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_ocr_box" value="&lt;b&gt;RapidOCR ONNX (Lưu Bounding Box &amp;amp; Điểm Tin Cậy)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Lưu [box, text, score] &amp;bull; Sắp xếp Reading Order 2 cột (Two-Column Layout)&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="110" y="460" width="290" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_filter_hf" value="&lt;b&gt;Loại bỏ Header/Footer Vùng Biên &amp;amp; Lặp Lại&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Loại bỏ dòng ở 8% đỉnh/đáy &amp;amp; lặp lại &amp;ge; 50% số trang&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="110" y="515" width="290" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_scan_rec" value="&lt;b&gt;OCRLayoutHierarchyPredictor (0% Regex)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;&amp;bull; Tỷ lệ cỡ chữ (rel_h = h/median_h) &amp;bull; Khoảng cách dọc (gap_before)&lt;br/&gt;&amp;bull; Căn giữa trang &amp;bull; Độ thụt lề Khoản/Điểm (&amp;Delta;x) &amp;bull; Miễn nhiễm 100% trích dẫn&lt;br/&gt;&amp;bull; TOC Verifier: Đối chiếu mục lục bằng fuzzy matching Unicode NFKD&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="110" y="568" width="290" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_tracker" value="&lt;b&gt;State Machine BreadcrumbTracker (Scan)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Stack Hình Học: title &amp;gt; h1 &amp;gt; h2 &amp;gt; h3 (Theo nhãn dự đoán OCR)&lt;br/&gt;Thụt lề Khoản/Điểm (indent_level 1-2) lưu vào metadata &amp;bull; Reset khi gặp Title&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="110" y="632" width="290" height="46" as="geometry"/>
        </mxCell>

        <!-- Nhánh Digital PDF & Tables -->
        <mxCell id="pdf_digital_pass" value="&lt;b&gt;Trích xuất Bảng pdf_table&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;find_tables() tuyến tính hóa hàng&lt;br/&gt;Lặp lại Header ở mọi chunk bảng&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="415" y="405" width="190" height="97" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_digital_stream" value="&lt;b&gt;Cross-Page Text Stream&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Ghép luồng toàn tài liệu&lt;br/&gt;split_sentences_banking an toàn&lt;br/&gt;page_start &amp;amp; page_end liên tục&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="415" y="515" width="190" height="103" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_fallback_tier" value="&lt;b&gt;Dự Đoán Đa Tầng Bố Cục: ocr_geometry_prediction &amp;rarr; page_fallback&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Đo độ tin cậy: layout_confidence, heading_ocr_confidence &amp;amp; avg_ocr_confidence&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;fontSize=10;shadow=1;align=center;">
          <mxGeometry x="110" y="692" width="495" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_bc" value="&lt;b&gt;Gắn Tiền Tố Phả Hệ &amp; Tham Chiếu Chuẩn Tắc&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;[Breadcrumbs: file.pdf &amp;gt; Mục lớn &amp;gt; Mục con] \n [Pháp lý: Tiêu đề chuẩn]&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontSize=11;shadow=1;align=center;">
          <mxGeometry x="110" y="745" width="495" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="pdf_out" value="&lt;b&gt;Tạo PDF Chunks Chuẩn Hóa Đa Dạng (pdf_text, pdf_ocr_scan, pdf_table)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;Bảo toàn 100% Breadcrumb, Lưu page_start/end, ocr_confidence, legal_ref, indent_level&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=11;fontStyle=1;shadow=1;align=center;">
          <mxGeometry x="110" y="870" width="495" height="45" as="geometry"/>
        </mxCell>

