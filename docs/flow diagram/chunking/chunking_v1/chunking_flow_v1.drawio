        <mxCell id="node_input_docs" value="&lt;b&gt;Kho Tài Liệu Ngân Hàng Mục Tiêu&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;&amp;bull; Word &lt;b&gt;.docx&lt;/b&gt; (Quy chế, Hướng dẫn)&lt;br/&gt;&amp;bull; PDF &lt;b&gt;.pdf&lt;/b&gt; (BCTC số, Bản scan mộc đỏ)&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;shadow=1;align=center;">
