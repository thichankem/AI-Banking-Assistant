        <!-- ==================== LUỒNG 2: DOCX CHUNKER ==================== -->
        <mxCell id="lane_docx" value="LUỒNG 2: DOCX CHUNKER (DOCUMENT LAYOUT AST &amp; TABLE ATOMICITY)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;swimlane;startSize=26;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1.5;fontColor=#5B21B6;fontSize=12;fontStyle=1;collapsible=0;shadow=1;">
          <mxGeometry x="720" y="275" width="640" height="715" as="geometry"/>
        </mxCell>

        <mxCell id="docx_open" value="&lt;b&gt;Mở Tệp Word DOCX (python-docx) &amp;amp; Quét Cấu Trúc DOM&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9.5px;color:#5B21B6;background:#F5F3FF;padding:1px 4px;border-radius:3px;'&gt;📄 docx_chunker/docx_chunker.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;'&gt;Trích xuất Textbox &amp;lt;w:txbxContent&amp;gt; &amp;bull; Duyệt Body DOM tuần tự theo XML&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=11;shadow=1;align=center;">
          <mxGeometry x="765" y="315" width="550" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="docx_branch" value="&lt;b&gt;Phân Loại Khối Element?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;&amp;lt;w:p&amp;gt; (Paragraph) hay &amp;lt;w:tbl&amp;gt; (Table)&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rhombus;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=9.5;fontStyle=1;shadow=1;align=center;">
          <mxGeometry x="930" y="380" width="220" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="docx_p_head" value="&lt;b&gt;Heading Hierarchy AST (Cấp 1..4)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9px;color:#3730A3;background:#EEF2FF;padding:1px 3px;border-radius:3px;'&gt;📄 docx_chunker/docx_chunker.py&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;'&gt;Styles chuẩn + In đậm (run.bold) &amp;bull; Cập nhật stack active_headers&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#3730A3;fontSize=9.5;shadow=1;align=center;">
