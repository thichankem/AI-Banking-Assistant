        <mxCell id="export_files" value="&lt;b&gt;Lưu Trữ File Phân Đoạn (Artifacts)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-family:Consolas,monospace;font-size:9.5px;color:#1D4ED8;background:#DBEAFE;padding:1px 3px;border-radius:3px;'&gt;📄 pipeline.py (run_chunking_pipeline)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:10px;'&gt;&amp;bull; &lt;b&gt;all_chunks.json&lt;/b&gt; &amp;amp; &lt;b&gt;all_chunks.jsonl&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;chunking_summary_stats.json&lt;/b&gt;&lt;br/&gt;&amp;bull; Lưu trữ tập trung tại: &lt;i&gt;rag_banking/storage/&lt;/i&gt;&lt;/span&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=10;shadow=1;align=left;spacingLeft=12;">
