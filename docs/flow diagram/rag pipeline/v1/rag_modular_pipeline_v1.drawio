<mxfile host="Electron" modified="2026-10-07T14:55:47.804Z" agent="DrawioEditor" version="24.0.0" type="device">
  <diagram id="diagram-1" name="RAG Modular Pipeline Architecture v1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
      <mxCell id="banner_title" value="&lt;div style=&quot;font-size: 18px; font-weight: bold; letter-spacing: 0.5px;&quot;&gt;KIẾN TRÚC MODULAR RAG PIPELINE v1.0 - AI BANKING ASSISTANT&lt;/div&gt;&lt;div style=&quot;font-size: 12.5px; margin-top: 5px; opacity: 0.9; font-weight: normal;&quot;&gt;Hệ Thống RAG Ngân Hàng Đa Phân Hệ: Ingestion Kép, Hybrid Retrieval (BM25 + Cosine), Hợp Nhất RRF, Tái Xếp Hạng &amp; LLM Serving&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;"><mxGeometry x="40" y="20" width="1370" height="65" as="geometry"/></mxCell><mxCell id="phase1_boundary" value="GIAI ĐOẠN 1: INGESTION &amp; DUAL-INDEXING PIPELINE (NẠP DỮ LIỆU &amp; LẬP CHỈ MỤC KÉP OFFLINE)" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1E293B;startSize=28;rounded=1;arcSize=4;shadow=1;"><mxGeometry x="40" y="100" width="1370" height="310" as="geometry"/></mxCell><mxCell id="doc_source" value="&lt;b&gt;📁 Tài Liệu Ngân Hàng&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Banking Regulations)&lt;/i&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• Quy trình mở tài khoản eKYC&lt;br/&gt;• Biểu phí &amp; Lãi suất tiết kiệm&lt;br/&gt;• Điều khoản phát hành thẻ &amp; Cho vay" vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=11;fontColor=#854D0E;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="65" y="165" width="180" height="95" as="geometry"/></mxCell><mxCell id="chunker_box" value="&lt;b&gt;✂️ BaseChunker (Cắt đoạn)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;FixedWindowChunker&lt;/b&gt; (300/50)&lt;br/&gt;• &lt;b&gt;FAQPairChunker&lt;/b&gt; (Cặp Q&amp;A)&lt;br/&gt;• &lt;b&gt;HierarchyMetadataChunker&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Bảo toàn ngữ cảnh Chương/Điều)&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=11;fontColor=#1E40AF;align=left;spacingLeft=10;shadow=1;"><mxGeometry x="295" y="160" width="205" height="105" as="geometry"/></mxCell><mxCell id="chunks_output" value="&lt;b&gt;📄 List[Chunk]&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• chunk_id, doc_id&lt;br/&gt;• text (đoạn nội dung)&lt;br/&gt;• metadata (breadcrumbs)" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;fontColor=#334155;align=left;spacingLeft=8;"><mxGeometry x="540" y="172" width="155" height="80" as="geometry"/></mxCell><mxCell id="keyword_indexer" value="&lt;b&gt;🔍 BaseKeywordSearcher&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;BM25OkapiSearcher&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;BM25PlusSearcher&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Tách từ vựng tiếng Việt, TF-IDF)&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#92400E;align=left;spacingLeft=10;shadow=1;"><mxGeometry x="735" y="135" width="220" height="80" as="geometry"/></mxCell><mxCell id="inverted_index_db" value="&lt;b&gt;🗄️ Inverted Index Store&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(BM25 Lexical Store)&lt;/i&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;Chỉ mục từ khóa đảo ngữ&lt;br/&gt;Term &amp; Document Freqs" vertex="1" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=11;fontColor=#78350F;shadow=1;"><mxGeometry x="995" y="130" width="180" height="90" as="geometry"/></mxCell><mxCell id="dense_embedder" value="&lt;b&gt;🧠 BaseEmbedding&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;Vietnamese_Embedding&lt;/b&gt; (1024d)&lt;br/&gt;• &lt;b&gt;Multilingual-E5 / BGE-M3&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Mô hình Embedding nơ-ron SOTA)&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontSize=11;fontColor=#3730A3;align=left;spacingLeft=10;shadow=1;"><mxGeometry x="735" y="250" width="220" height="80" as="geometry"/></mxCell><mxCell id="vector_db" value="&lt;b&gt;💾 Vector Database&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(ChromaDB / Weaviate / Qdrant)&lt;/i&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;Không gian Vector 1024 chiều&lt;br/&gt;HNSW Cosine Vector Store" vertex="1" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#312E81;shadow=1;"><mxGeometry x="995" y="245" width="180" height="90" as="geometry"/></mxCell><mxCell id="indexing_strategy_note" value="&lt;b&gt;💡 Chiến Lược Index Kép&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;Sparse (BM25):&lt;/b&gt; Bắt chính xác mã số, thuật ngữ pháp lý, tỷ lệ % lãi suất.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Dense (Cosine 1024d):&lt;/b&gt; Bắt ý định người dùng (Deep Semantic Intent) qua không gian nơ-ron." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=10.5;fontColor=#334155;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="1210" y="135" width="180" height="190" as="geometry"/></mxCell><mxCell id="e_doc_chunk" value="1. Nạp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#1E40AF;" edge="1" parent="1" source="doc_source" target="chunker_box"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_chunk_out" value="2. Chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#1E40AF;" edge="1" parent="1" source="chunker_box" target="chunks_output"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_chunk_kw" value="3a. Từ khóa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#92400E;" edge="1" parent="1" source="chunks_output" target="keyword_indexer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_kw_inv" value="Lưu chỉ mục" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#92400E;" edge="1" parent="1" source="keyword_indexer" target="inverted_index_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_chunk_emb" value="3b. Embed 1024d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#3730A3;" edge="1" parent="1" source="chunks_output" target="dense_embedder"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_emb_vdb" value="Lưu Vector" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#3730A3;" edge="1" parent="1" source="dense_embedder" target="vector_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="phase2_boundary" value="GIAI ĐOẠN 2: ONLINE QUERY &amp; MULTI-STAGE REFINEMENT PIPELINE (TRUY VẤN THỜI GIAN THỰC)" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0369A1;startSize=28;rounded=1;arcSize=4;shadow=1;"><mxGeometry x="40" y="440" width="1370" height="520" as="geometry"/></mxCell><mxCell id="user_actor" value="&lt;b&gt;Khách Hàng&lt;/b&gt;&lt;br/&gt;(User)" vertex="1" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1E40AF;"><mxGeometry x="55" y="505" width="60" height="110" as="geometry"/></mxCell><mxCell id="user_query" value="&lt;b&gt;💬 Câu Hỏi Khách Hàng&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(User Query)&lt;/i&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&quot;Hạn mức mở tài khoản eKYC tối đa bao nhiêu 1 ngày?&quot;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=11;fontColor=#115E59;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="145" y="515" width="160" height="85" as="geometry"/></mxCell><mxCell id="query_parser" value="&lt;b&gt;⚙️ Bước 1: Query Parser&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;BankingSynonymNormalizer&lt;/b&gt;&lt;br/&gt;• Chuẩn hóa từ viết tắt (eKYC, TKTT)&lt;br/&gt;• Trích xuất từ khóa trọng tâm&lt;br/&gt;➔ &lt;b&gt;ParsedQuery&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=11;fontColor=#581C87;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="345" y="510" width="180" height="95" as="geometry"/></mxCell><mxCell id="hybrid_retriever" value="&lt;b&gt;🔄 Bước 2: Hybrid Retriever &amp; Fusion&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;Dense Search&lt;/b&gt;: HNSW Cosine qua ChromaDB&lt;br/&gt;• &lt;b&gt;Sparse Search&lt;/b&gt;: Khớp từ khóa qua Inverted Index&lt;br/&gt;&lt;hr style=&quot;margin:3px 0;&quot;/&gt;&lt;b&gt;Thuật Toán Hợp Nhất (Fusion):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;RRF (Reciprocal Rank Fusion, k=60)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;WeightedLinearHybrid (α=0.5)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;color:#0369A1; font-weight:bold; margin-top:2px;&quot;&gt;➔ Xuất Top-5 Candidates&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=10.5;fontColor=#155E75;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="565" y="490" width="225" height="145" as="geometry"/></mxCell><mxCell id="reranker_box" value="&lt;b&gt;🎯 Bước 3: Reranking&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;FAQQuestionCrossMatch&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;LexicalOverlapReranker&lt;/b&gt;&lt;br/&gt;• So khớp câu hỏi vàng Golden Match&lt;br/&gt;• Loại bỏ phân đoạn gây nhiễu&lt;br/&gt;&lt;div style=&quot;color:#B91C1C; font-weight:bold; margin-top:2px;&quot;&gt;➔ Tinh tuyển Top-3 Chunks&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontColor=#991B1B;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="825" y="505" width="195" height="115" as="geometry"/></mxCell><mxCell id="synthesizer_box" value="&lt;b&gt;📦 Bước 4: Context Synth&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;StructuredFAQContext&lt;/b&gt;&lt;br/&gt;• Định dạng Markdown chuẩn hóa&lt;br/&gt;• Trích xuất mã Citations [Điều X]&lt;br/&gt;• Truncate bảo vệ Token Budget&lt;br/&gt;&lt;div style=&quot;color:#831843; font-weight:bold; margin-top:2px;&quot;&gt;➔ ContextPackage&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=2;fontSize=11;fontColor=#831843;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="1055" y="505" width="170" height="115" as="geometry"/></mxCell><mxCell id="llm_box" value="&lt;b&gt;🤖 Bước 5: Banking LLM&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;DeepSeek-V3 / R1 (Enterprise Gateway)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;MockBankLLM / Gemini&lt;/b&gt;&lt;br/&gt;• System Banking Guardrails&lt;br/&gt;• Sinh phản hồi chính xác" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#4C1D95;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="1255" y="510" width="140" height="105" as="geometry"/></mxCell><mxCell id="rag_response" value="&lt;b&gt;📋 KẾT QUẢ ĐẦU RA HOÀN CHỈNH (RAGResponse)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;Câu trả lời nghiệp vụ (Answer):&lt;/b&gt; &lt;i&gt;&quot;Theo quy định eKYC, hạn mức giao dịch tối đa là 100 triệu VNĐ/ngày (hoặc 400 triệu nếu kích hoạt sinh trắc học NFC).&quot;&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;Dẫn chứng pháp lý (Citations):&lt;/b&gt; &lt;i&gt;[Quy chế eKYC - Điều 12, Khoản 2; Thông tư 17/NHNN]&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;Bảng đo độ trễ chi tiết từng module (latency_breakdown_ms):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[1. Query Parsing: ~1.2ms] ➔ [2. Retrieval: ~8.5ms] ➔ [3. Rerank: ~3.1ms] ➔ [4. Context: ~0.8ms] ➔ [5. LLM: ~820ms]&lt;br/&gt;• &lt;b&gt;Tổng thời gian thực thi (Total Latency):&lt;/b&gt; &lt;b&gt;~833.6 ms&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#065F46;align=left;spacingLeft=12;shadow=1;"><mxGeometry x="640" y="690" width="630" height="135" as="geometry"/></mxCell><mxCell id="benchmark_panel" value="&lt;b&gt;📊 BỘ ĐÁNH GIÁ THỰC NGHIỆM (BenchmarkRunner)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;Đo lường &amp; So sánh 4 cấu hình Pipelines thực tế trên tập Banking QA:&lt;br/&gt;• &lt;b&gt;Pipeline 1 (Naive Dense):&lt;/b&gt; FixedWindow + DenseOnly (Hit@3: 72.0% | MRR: 0.65)&lt;br/&gt;• &lt;b&gt;Pipeline 2 (Classic BM25):&lt;/b&gt; FAQPair + BM25Okapi (Hit@3: 84.5% | MRR: 0.78)&lt;br/&gt;• &lt;b&gt;Pipeline 3 (Linear Hybrid):&lt;/b&gt; α=0.5 + LexicalOverlap (Hit@3: 91.2% | MRR: 0.86)&lt;br/&gt;• &lt;b&gt;Pipeline 4 (Advanced RRF):&lt;/b&gt; RRF (k=60) + Golden Match (Hit@3: &lt;b&gt;98.5%&lt;/b&gt; | MRR: &lt;b&gt;0.96&lt;/b&gt;)" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;strokeDasharray=4 4;fontSize=10.5;fontColor=#1E293B;align=left;spacingLeft=10;shadow=1;"><mxGeometry x="100" y="690" width="500" height="135" as="geometry"/></mxCell><mxCell id="e_user_msg" value="Hỏi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D9488;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#115E59;" edge="1" parent="1" source="user_actor" target="user_query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_query_parse" value="1. Gửi query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#581C87;" edge="1" parent="1" source="user_query" target="query_parser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_parse_retriever" value="2. Parsed Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0891B2;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#155E75;" edge="1" parent="1" source="query_parser" target="hybrid_retriever"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_db_bm25_retriever" value="Sparse Lookup (BM25)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=2;strokeDasharray=4 4;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#B45309;" edge="1" parent="1" source="inverted_index_db" target="hybrid_retriever"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1085" y="425"/><mxPoint x="670" y="425"/></Array></mxGeometry></mxCell><mxCell id="e_db_vector_retriever" value="Dense Lookup (Chroma HNSW)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4F46E5;strokeWidth=2;strokeDasharray=4 4;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#4338CA;" edge="1" parent="1" source="vector_db" target="hybrid_retriever"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="435"/><mxPoint x="630" y="435"/></Array></mxGeometry></mxCell><mxCell id="e_retriever_rerank" value="Top-5 Chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EF4444;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#991B1B;" edge="1" parent="1" source="hybrid_retriever" target="reranker_box"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_rerank_synth" value="Top-3 Chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DB2777;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#831843;" edge="1" parent="1" source="reranker_box" target="synthesizer_box"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_synth_llm" value="Prompt + Context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#4C1D95;" edge="1" parent="1" source="synthesizer_box" target="llm_box"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_llm_response" value="Sinh Answer &amp; Citations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontColor=#047857;" edge="1" parent="1" source="llm_box" target="rag_response"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325" y="650"/><mxPoint x="1200" y="650"/></Array></mxGeometry></mxCell><mxCell id="e_response_user" value="Trả về phản hồi chuẩn xác cho Khách Hàng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;strokeDasharray=4 4;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontColor=#065F46;" edge="1" parent="1" source="rag_response" target="user_actor"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="885"/><mxPoint x="80" y="885"/></Array></mxGeometry></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>