  <diagram id="diagram-rag-modular-v2" name="Modular RAG Pipeline v2.0">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1440" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="banner_title" value="&lt;div style=&quot;font-size: 19px; font-weight: bold; letter-spacing: 0.5px;&quot;&gt;KIẾN TRÚC TOÀN DIỆN MODULAR RAG PIPELINE v2.0 - AI BANKING ASSISTANT&lt;/div&gt;&lt;div style=&quot;font-size: 12px; margin-top: 6px; opacity: 0.95; font-weight: normal;&quot;&gt;Hệ Thống RAG Ngân Hàng Đa Phân Hệ 9 Tầng: Dual Ingestion (6 Chunkers) ➔ Hybrid Retrieval (HNSW Dense + BM25+ Sparse) ➔ Reciprocal Rank Fusion (RRF k=60) ➔ FAQ Golden Match Rerank ➔ Token Budget Control ➔ Enterprise LLM Serving &amp; Benchmark Profiling&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;"><mxGeometry x="40" y="20" width="1720" height="75" as="geometry"/></mxCell>
        <mxCell id="phase1_boundary" value="GIAI ĐOẠN 1: INGESTION &amp; DUAL-INDEXING PIPELINE (NẠP DỮ LIỆU &amp; LẬP CHỈ MỤC KÉP OFFLINE - 4 SUB-MODULES)" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0F172A;startSize=28;rounded=1;arcSize=4;shadow=1;"><mxGeometry x="40" y="110" width="1720" height="370" as="geometry"/></mxCell>
        <mxCell id="doc_source" value="&lt;b&gt;📁 Tài Liệu Ngân Hàng (Document)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Banking Regulations &amp; Knowledge Base)&lt;/i&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;id&lt;/b&gt;: Mã văn bản (faq_1, faq_2...)&lt;br/&gt;• &lt;b&gt;title&lt;/b&gt;: Tiêu đề quy chế / câu hỏi&lt;br/&gt;• &lt;b&gt;content&lt;/b&gt;: Nội dung giải đáp chi tiết&lt;br/&gt;• &lt;b&gt;metadata&lt;/b&gt;: {topic, subtopic, path, chapter...}&lt;br/&gt;&lt;div style=&quot;margin-top:4px; color:#B45309; font-size:10px;&quot;&gt;➔ &lt;i&gt;305 FAQs Vietcombank, eKYC, TT17/NHNN...&lt;/i&gt;&lt;/div&gt;" vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=10.5;fontColor=#854D0E;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="65" y="160" width="220" height="140" as="geometry"/></mxCell>
        <mxCell id="chunker_box" value="&lt;b&gt;✂️ Phân Hệ 1: BaseChunker (6 Chiến Lược)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;FixedWindowChunker&lt;/b&gt;: size=300, overlap=50 chars&lt;br/&gt;• &lt;b&gt;SentenceRegexChunker&lt;/b&gt;: max_chars=350, r&quot;[.?!;\n]&quot;&lt;br/&gt;• &lt;b&gt;FAQPairChunker&lt;/b&gt;: Bảo toàn nguyên tử Q&amp;A&lt;br/&gt;• &lt;b&gt;HierarchyMetadataChunker&lt;/b&gt;: Làm giàu [Topic][Path]&lt;br/&gt;• &lt;b&gt;ParagraphSplitChunker&lt;/b&gt;: Cắt theo ranh giới &quot;\n\n&quot;&lt;br/&gt;• &lt;b&gt;SemanticSlidingChunker&lt;/b&gt;: Lệch Jaccard &lt; 0.15&lt;br/&gt;&lt;div style=&quot;margin-top:4px; color:#1E40AF; font-weight:bold; font-size:10px;&quot;&gt;➔ chunk(documents) ➔ List[Chunk]&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=10.5;fontColor=#1E40AF;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="320" y="150" width="265" height="195" as="geometry"/></mxCell>
        <mxCell id="chunks_output" value="&lt;b&gt;📄 List[Chunk] (Khuôn Mẫu)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;id&lt;/b&gt;: Mã mảnh (faq_1_fix_0)&lt;br/&gt;• &lt;b&gt;doc_id&lt;/b&gt;: ID tài liệu cha&lt;br/&gt;• &lt;b&gt;text&lt;/b&gt;: Đoạn văn bản đã cắt&lt;br/&gt;• &lt;b&gt;metadata&lt;/b&gt;: Breadcrumbs ngữ cảnh&lt;br/&gt;• &lt;b&gt;embedding&lt;/b&gt;: Optional[List[float]]" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontSize=10;fontColor=#334155;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="625" y="185" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="keyword_indexer" value="&lt;b&gt;🔍 Phân Hệ 4: BaseKeywordSearcher (Sparse)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;BM25OkapiSearcher&lt;/b&gt;: k1=1.5, b=0.75, bão hòa TF &amp; IDF&lt;br/&gt;• &lt;b&gt;BM25PlusSearcher&lt;/b&gt;: δ=1.0, chống phạt tài liệu dài&lt;br/&gt;• &lt;b&gt;TFIDFKeywordSearcher&lt;/b&gt;: Trọng số TF-IDF cổ điển&lt;br/&gt;• &lt;b&gt;ExactAndFuzzySubstringSearcher&lt;/b&gt;: Khớp xâu &amp; mờ&lt;br/&gt;&lt;div style=&quot;margin-top:3px; color:#92400E; font-weight:bold; font-size:10px;&quot;&gt;➔ index(chunks) | search(query, top_k)&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=10;fontColor=#92400E;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="820" y="145" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="inverted_index_db" value="&lt;b&gt;🗄️ Inverted Index Store&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(BM25 Lexical Store)&lt;/i&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• Bảng tần suất từ: Term Freqs&lt;br/&gt;• Điểm hiếm nghịch đảo: IDF Table&lt;br/&gt;• Bảng độ dài &amp; AvgDocLen" vertex="1" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=10;fontColor=#78350F;shadow=1;"><mxGeometry x="1145" y="145" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="dense_embedder" value="&lt;b&gt;🧠 Phân Hệ 2: BaseEmbedding (Dense Neural)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;CloudEmbedding&lt;/b&gt;: Vietnamese_Embedding 1024d, Multilingual-E5, BGE-M3 (Context 8K)&lt;br/&gt;• &lt;b&gt;SentenceTransformerEmbedding&lt;/b&gt;: Bi-Encoder cục bộ&lt;br/&gt;• &lt;b&gt;RemoteAPIEmbedding&lt;/b&gt;: OpenAI text-embedding-3&lt;br/&gt;• &lt;b&gt;BankingConceptSemanticEmbedding&lt;/b&gt;: Domain ontology&lt;br/&gt;• &lt;b&gt;DeterministicDenseEmbedding&lt;/b&gt;: Băm tái lập&lt;br/&gt;&lt;div style=&quot;margin-top:3px; color:#3730A3; font-weight:bold; font-size:10px;&quot;&gt;➔ embed_batch(texts) ➔ List[List[float]] (1024d)&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontSize=10;fontColor=#3730A3;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="820" y="305" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="vector_db" value="&lt;b&gt;💾 Phân Hệ 3: BaseVectorDB (HNSW Engine)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;ChromaVectorDB&lt;/b&gt;: In-Memory / Persistent Client&lt;br/&gt;• &lt;b&gt;QdrantVectorDB&lt;/b&gt;: Rust Engine, :memory: / Server&lt;br/&gt;• &lt;b&gt;WeaviateVectorDB&lt;/b&gt;: WCS / Local Docker&lt;br/&gt;• &lt;i&gt;(NumpyCosineVectorDB - Deprecated)&lt;/i&gt;&lt;br/&gt;&lt;div style=&quot;margin-top:3px; color:#312E81; font-weight:bold; font-size:10px;&quot;&gt;➔ Không gian HNSW Cosine Index&lt;/div&gt;" vertex="1" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=10;fontColor=#312E81;shadow=1;"><mxGeometry x="1145" y="305" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="indexing_strategy_note" value="&lt;b&gt;💡 Chiến Lược Lập Chỉ Mục Kép Toàn Diện&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;Nhánh Từ Khóa (BM25 Okapi/+)&lt;/b&gt;:&lt;br/&gt;  Bắt chính xác 100% thuật ngữ pháp lý, điều khoản Thông tư, mã biểu phí, tỷ lệ % lãi suất và tên viết tắt.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Nhánh Vector (Dense HNSW 1024d)&lt;/b&gt;:&lt;br/&gt;  Bắt trọn vẹn ngữ nghĩa sâu (Deep Semantic Intent) khi câu hỏi dùng từ ngữ đời thường khác xa văn bản gốc.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Bảo Toàn Ngữ Cảnh Phân Cấp&lt;/b&gt;:&lt;br/&gt;  HierarchyMetadata loại bỏ triệt để bẫy đồng chỉ (Co-reference Trap)." vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="1380" y="145" width="360" height="290" as="geometry"/></mxCell>
        <mxCell id="e_doc_chunk" value="1. Đọc" edge="1" parent="1" source="doc_source" target="chunker_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#1E40AF;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_chunk_out" value="2. Chunks" edge="1" parent="1" source="chunker_box" target="chunks_output" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#1E40AF;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_chunk_kw" value="3a. Sparse" edge="1" parent="1" source="chunks_output" target="keyword_indexer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#92400E;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="225"/><mxPoint x="805" y="205"/></Array></mxGeometry></mxCell>
        <mxCell id="e_kw_inv" value="" edge="1" parent="1" source="keyword_indexer" target="inverted_index_db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=1.8;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_chunk_emb" value="3b. Dense Batch" edge="1" parent="1" source="chunks_output" target="dense_embedder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#3730A3;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="265"/><mxPoint x="805" y="380"/></Array></mxGeometry></mxCell>
        <mxCell id="e_emb_vdb" value="" edge="1" parent="1" source="dense_embedder" target="vector_db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.8;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="phase2_boundary" value="GIAI ĐOẠN 2: ONLINE QUERY, MULTI-STAGE REFINEMENT &amp; LLM SERVING (TRUY VẤN THỜI GIAN THỰC - 5 PHÂN HỆ TUẦN TỰ)" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0369A1;startSize=28;rounded=1;arcSize=4;shadow=1;"><mxGeometry x="40" y="505" width="1720" height="490" as="geometry"/></mxCell>
        <mxCell id="user_actor" value="&lt;b&gt;Khách Hàng&lt;/b&gt;&lt;br/&gt;(Bank User)" vertex="1" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1E40AF;"><mxGeometry x="60" y="580" width="55" height="100" as="geometry"/></mxCell>
        <mxCell id="user_query" value="&lt;b&gt;💬 Câu Hỏi Khách Hàng&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Raw User Query)&lt;/i&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&quot;mở stk qua ekyc trên vcb cần cccd không và hạn mức 1 ngày bao nhiêu?&quot;&lt;div style=&quot;margin-top:4px; color:#0F766E; font-size:9.5px;&quot;&gt;• Chứa từ viết tắt: stk, ekyc, vcb, cccd&lt;br/&gt;• Ý định: Điều kiện mở &amp; Hạn mức&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=10;fontColor=#115E59;align=left;spacingLeft=6;shadow=1;"><mxGeometry x="140" y="565" width="160" height="130" as="geometry"/></mxCell>
        <mxCell id="query_parser" value="&lt;b&gt;⚙️ Bước 1: BaseQueryParser&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;BankingSynonymAndNormalizer&lt;/b&gt;:&lt;br/&gt;  vcb ➔ vietcombank, stk ➔ số tài khoản, cccd ➔ căn cước công dân gắn chip, ekyc ➔ định danh điện tử&lt;br/&gt;• &lt;b&gt;BankingKeywordExtractorParser&lt;/b&gt;:&lt;br/&gt;  Lọc stopword, trích xuất keywords&lt;br/&gt;• &lt;b&gt;MultiQueryExpander&lt;/b&gt;: 3 góc nhìn nghiệp vụ&lt;br/&gt;• &lt;b&gt;HyDEQueryParser&lt;/b&gt;: Câu trả lời giả định&lt;br/&gt;• &lt;b&gt;PassThroughQueryParser&lt;/b&gt;: Giữ nguyên&lt;br/&gt;&lt;div style=&quot;margin-top:4px; color:#581C87; font-weight:bold; font-size:10px;&quot;&gt;➔ Xuất: ParsedQuery Data Model&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=10;fontColor=#581C87;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="335" y="545" width="245" height="175" as="geometry"/></mxCell>
        <mxCell id="hybrid_retriever" value="&lt;b&gt;🔄 Bước 2: BaseRetriever &amp; Fusion&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;Dense Search&lt;/b&gt;: HNSW Cosine (Top-20 cand)&lt;br/&gt;• &lt;b&gt;Sparse Search&lt;/b&gt;: Inverted BM25 (Top-20 cand)&lt;br/&gt;&lt;hr style=&quot;margin:3px 0;&quot;/&gt;&lt;b&gt;Thuật Toán Hợp Nhất Thứ Hạng (Fusion):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;ReciprocalRankFusionRetriever (RRF k=60)&lt;/b&gt;:&lt;br/&gt;  RRF(d) = Σ [ 1 / (60 + rank_m(d)) ]&lt;br/&gt;• &lt;b&gt;WeightedLinearHybrid&lt;/b&gt;: α·Dense + (1-α)·Sparse&lt;br/&gt;• &lt;b&gt;ThresholdFilteredHybrid&lt;/b&gt;: Cắt sàn ≥ 0.4 Top-1&lt;br/&gt;• &lt;b&gt;DenseOnlyRetriever / SparseOnlyRetriever&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;margin-top:4px; color:#155E75; font-weight:bold; font-size:10px;&quot;&gt;➔ Xuất: Top-5 RetrievalResult&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=10;fontColor=#155E75;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="620" y="535" width="270" height="195" as="geometry"/></mxCell>
        <mxCell id="reranker_box" value="&lt;b&gt;🎯 Bước 3: BaseReranker (Tái Xếp Hạng)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;FAQQuestionCrossMatchReranker&lt;/b&gt;:&lt;br/&gt;  &lt;i&gt;So khớp câu hỏi vàng trong metadata:&lt;/i&gt;&lt;br/&gt;  &lt;b&gt;Score = 0.6·Sim(Q_khách, Q_vàng) + 0.4·Score_retrieval&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;LexicalOverlapReranker&lt;/b&gt;: Trùng lặp từ vựng&lt;br/&gt;• &lt;b&gt;ScoreBlendedReranker&lt;/b&gt;: Thưởng cụm từ +0.2&lt;br/&gt;• &lt;b&gt;IdentityReranker&lt;/b&gt;: Giữ nguyên thứ tự&lt;br/&gt;&lt;div style=&quot;margin-top:4px; color:#991B1B; font-weight:bold; font-size:10px;&quot;&gt;➔ Tinh tuyển: Top-3 RerankResult&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=10;fontColor=#991B1B;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="930" y="545" width="255" height="175" as="geometry"/></mxCell>
        <mxCell id="synthesizer_box" value="&lt;b&gt;📦 Bước 4: BaseContextSynthesizer&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;StructuredFAQContextSynthesizer&lt;/b&gt;:&lt;br/&gt;  Định dạng Markdown ngân hàng chuẩn hóa:&lt;br/&gt;  - &lt;i&gt;### [Tài Liệu #{rank} | Điểm: {score}]&lt;/i&gt;&lt;br/&gt;  - &lt;i&gt;Chuyên mục: {topic} &gt; {subtopic}&lt;/i&gt;&lt;br/&gt;  - &lt;i&gt;Câu hỏi chuẩn &amp; Nội dung giải đáp&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;BudgetTruncationSynthesizer&lt;/b&gt;: Cắt ≤ 1500 chars&lt;br/&gt;• &lt;b&gt;RawConcatSynthesizer&lt;/b&gt;: Nối thô &quot;---&quot;&lt;br/&gt;&lt;div style=&quot;margin-top:4px; color:#831843; font-weight:bold; font-size:10px;&quot;&gt;➔ Xuất: ContextPackage + Citations&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=2;fontSize=10;fontColor=#831843;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="1225" y="545" width="240" height="175" as="geometry"/></mxCell>
        <mxCell id="llm_box" value="&lt;b&gt;🤖 Bước 5: BaseLLM Serving&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;CloudLLM (Enterprise Gateway)&lt;/b&gt;:&lt;br/&gt;  DeepSeek-V3, DeepSeek-R1, Llama-3 qua /chat/completions; Banking Guardrails&lt;br/&gt;• &lt;b&gt;GenericOpenAILLM&lt;/b&gt;: GPT-4o, Gemini&lt;br/&gt;• &lt;b&gt;MockBankLLM&lt;/b&gt;: Offline 0-cost, &lt;1ms, trích xuất chính xác, không bịa đặt&lt;br/&gt;&lt;div style=&quot;margin-top:4px; padding:2px; background:#EDE9FE; border-radius:3px; color:#4C1D95; font-size:9.5px;&quot;&gt;🛡️ &lt;b&gt;Auto-Fallback&lt;/b&gt;: Lỗi mạng/thiếu API key ➔ MockBankLLM!&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=10;fontColor=#4C1D95;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="1505" y="545" width="225" height="175" as="geometry"/></mxCell>
        <mxCell id="e_user_msg" value="Hỏi" edge="1" parent="1" source="user_actor" target="user_query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D9488;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#115E59;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_query_parse" value="1. Query" edge="1" parent="1" source="user_query" target="query_parser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#581C87;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_parse_retriever" value="2. Parsed" edge="1" parent="1" source="query_parser" target="hybrid_retriever" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0891B2;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#155E75;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_db_bm25_retriever" value="Sparse Lookup (BM25)" edge="1" parent="1" source="inverted_index_db" target="hybrid_retriever" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=1.8;strokeDasharray=4 4;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#B45309;exitX=1;exitY=0.5;entryX=0.65;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="202"/><mxPoint x="1355" y="480"/><mxPoint x="795" y="480"/><mxPoint x="795" y="535"/></Array></mxGeometry></mxCell>
        <mxCell id="e_db_vector_retriever" value="Dense Lookup (HNSW Cosine)" edge="1" parent="1" source="vector_db" target="hybrid_retriever" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4F46E5;strokeWidth=1.8;strokeDasharray=4 4;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#4338CA;exitX=0.5;exitY=1;entryX=0.35;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="435"/><mxPoint x="1240" y="495"/><mxPoint x="715" y="495"/><mxPoint x="715" y="535"/></Array></mxGeometry></mxCell>
        <mxCell id="e_retriever_rerank" value="3. Top-5" edge="1" parent="1" source="hybrid_retriever" target="reranker_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EF4444;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#991B1B;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_rerank_synth" value="4. Top-3" edge="1" parent="1" source="reranker_box" target="synthesizer_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DB2777;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#831843;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_synth_llm" value="5. Context" edge="1" parent="1" source="synthesizer_box" target="llm_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#4C1D95;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="phase3_boundary" value="GIAI ĐOẠN 3: KẾT QUẢ ĐẦU RA, BẤM GIỜ TỪNG MODULE &amp; ĐỐI CHUẨN THỰC NGHIỆM (RAGResponse &amp; BENCHMARK PROFILE)" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#10B981;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#065F46;startSize=28;rounded=1;arcSize=4;shadow=1;"><mxGeometry x="40" y="1015" width="1720" height="395" as="geometry"/></mxCell>
        <mxCell id="rag_response" value="&lt;b&gt;📋 KẾT QUẢ ĐẦU RA TOÀN DIỆN (RAGResponse Data Class)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;query&lt;/b&gt;: &quot;mở stk qua ekyc trên vcb cần cccd không và hạn mức 1 ngày bao nhiêu?&quot;&lt;br/&gt;• &lt;b&gt;answer&lt;/b&gt;: Lời giải đáp chuẩn mực, lịch sự, 100% dựa trên tài liệu ngân hàng:&lt;br/&gt;  &lt;i&gt;&quot;Kính chào Quý khách! Để mở tài khoản qua eKYC trên VCB Digibank, Quý khách cần có CCCD gắn chip còn hiệu lực. Hạn mức giao dịch tối đa là 100 triệu VNĐ/ngày (nâng lên 400 triệu nếu kích hoạt sinh trắc học NFC)...&quot;&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;citations&lt;/b&gt;: Trích dẫn kiểm toán minh bạch:&lt;br/&gt;  &lt;i&gt;[Tài Liệu #1: Quy chế eKYC - Điều 12; Tài Liệu #2: Biểu phí &amp; Hạn mức TKTT]&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;retrieved_chunks&lt;/b&gt;: Danh sách các chunk thực tế đã được tinh tuyển&lt;br/&gt;• &lt;b&gt;pipeline_config&lt;/b&gt;: Lưu vết cấu hình 9 module đang vận hành" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=10;fontColor=#065F46;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="65" y="1060" width="530" height="330" as="geometry"/></mxCell>
        <mxCell id="pipeline_profiler" value="&lt;b&gt;⏱️ PHÂN HỆ ĐIỀU PHỐI: RAG PIPELINE (rag_pipeline)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;b&gt;Nhạc Trưởng (Master Orchestrator - rag_pipeline)&lt;/b&gt;:&lt;br/&gt;  Chứa Data Models nền tảng &amp; lớp ModularRAGPipeline khởi tạo độc lập 9 modules, điều phối luồng tuần tự không rò rỉ trạng thái.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Hạ Tầng Đo Đạc Vi Mô (latency_breakdown_ms qua time.perf_counter)&lt;/b&gt;:&lt;br/&gt;  - &lt;b&gt;1_query_parsing_ms&lt;/b&gt;: &lt;b style=&quot;color:#1D4ED8;&quot;&gt;~1.15 ms&lt;/b&gt; (Dịch từ viết tắt, bóc từ khóa)&lt;br/&gt;  - &lt;b&gt;2_retrieval_ms&lt;/b&gt;: &lt;b style=&quot;color:#0E7490;&quot;&gt;~8.42 ms&lt;/b&gt; (Song song HNSW + BM25 &amp; RRF)&lt;br/&gt;  - &lt;b&gt;3_reranking_ms&lt;/b&gt;: &lt;b style=&quot;color:#B91C1C;&quot;&gt;~3.20 ms&lt;/b&gt; (So khớp FAQ Golden Match)&lt;br/&gt;  - &lt;b&gt;4_context_synthesis_ms&lt;/b&gt;: &lt;b style=&quot;color:#BE185D;&quot;&gt;~0.85 ms&lt;/b&gt; (Đóng gói Markdown &amp; Budget)&lt;br/&gt;  - &lt;b&gt;5_llm_generation_ms&lt;/b&gt;: &lt;b style=&quot;color:#6D28D9;&quot;&gt;~812.50 ms&lt;/b&gt; (Cloud Gateway DeepSeek-V3)&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;total_latency_ms&lt;/b&gt;: &lt;b style=&quot;color:#047857; font-size:11.5px;&quot;&gt;~826.12 ms&lt;/b&gt; (Tổng thời gian xử lý)" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontSize=10;fontColor=#075985;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="640" y="1060" width="510" height="330" as="geometry"/></mxCell>
        <mxCell id="benchmark_panel" value="&lt;b&gt;📊 BẢNG ĐỐI CHUẨN THỰC NGHIỆM 4 CẤU HÌNH PIPELINES (GR2 BENCHMARK)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;Đo lường trên tập 305 câu hỏi FAQ thực tế của Vietcombank:&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Pipeline 1 (Naive Dense Baseline)&lt;/b&gt;:&lt;br/&gt;  FixedWindow + DenseOnly(Chroma) + Identity&lt;br/&gt;  ➔ &lt;b&gt;Hit@3: 72.0%&lt;/b&gt; | &lt;b&gt;MRR: 0.65&lt;/b&gt; | Trễ: ~420ms | &lt;i&gt;(Dễ dính bẫy đồng chỉ)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Pipeline 2 (Classic BM25 Keyword)&lt;/b&gt;:&lt;br/&gt;  FAQPair + BM25Okapi + Identity&lt;br/&gt;  ➔ &lt;b&gt;Hit@3: 84.5%&lt;/b&gt; | &lt;b&gt;MRR: 0.78&lt;/b&gt; | Trễ: ~25ms | &lt;i&gt;(Khớp tốt từ khóa hiếm)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Pipeline 3 (Linear Hybrid + Overlap)&lt;/b&gt;:&lt;br/&gt;  HierarchyMetadata + WeightedHybrid(α=0.5) + LexicalOverlap&lt;br/&gt;  ➔ &lt;b&gt;Hit@3: 91.2%&lt;/b&gt; | &lt;b&gt;MRR: 0.86&lt;/b&gt; | Trễ: ~55ms | &lt;i&gt;(Cân bằng ngữ nghĩa)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Pipeline 4 (Advanced RRF + Golden Match - SOTA Stack)&lt;/b&gt;:&lt;br/&gt;  HierarchyMetadata + RRF(k=60) + FAQQuestionCrossMatch&lt;br/&gt;  ➔ &lt;b style=&quot;color:#047857;&quot;&gt;Hit@3: 98.5%&lt;/b&gt; | &lt;b style=&quot;color:#047857;&quot;&gt;MRR: 0.96&lt;/b&gt; | Trễ: ~68ms | &lt;i&gt;(Độ chính xác vượt trội)&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;strokeDasharray=4 4;fontSize=10;fontColor=#1E293B;align=left;spacingLeft=8;shadow=1;"><mxGeometry x="1190" y="1060" width="540" height="330" as="geometry"/></mxCell>
        <mxCell id="e_llm_to_res" value="Sinh Answer &amp; Citations" edge="1" parent="1" source="llm_box" target="rag_response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontSize=10.5;fontColor=#047857;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1617" y="720"/><mxPoint x="1617" y="1005"/><mxPoint x="330" y="1005"/><mxPoint x="330" y="1060"/></Array></mxGeometry></mxCell>
        <mxCell id="e_res_to_profiler" value="" edge="1" parent="1" source="rag_response" target="pipeline_profiler" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284C7;strokeWidth=2;endArrow=block;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="1225"/><mxPoint x="640" y="1225"/></Array></mxGeometry></mxCell>
        <mxCell id="e_prof_to_bench" value="" edge="1" parent="1" source="pipeline_profiler" target="benchmark_panel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;strokeDasharray=3 3;endArrow=block;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="1225"/><mxPoint x="1190" y="1225"/></Array></mxGeometry></mxCell>
        <mxCell id="e_response_user" value="Phản hồi chuẩn xác cho Khách Hàng" edge="1" parent="1" source="rag_response" target="user_actor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;strokeDasharray=4 4;labelBackgroundColor=#FFFFFF;fontSize=10;fontColor=#065F46;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="65" y="1225"/><mxPoint x="25" y="1225"/><mxPoint x="25" y="630"/><mxPoint x="60" y="630"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>