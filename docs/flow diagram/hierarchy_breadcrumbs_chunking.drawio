<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-10-10T22:15:00.000Z" agent="DrawioEditor" version="24.0.0" type="device">
  <diagram id="diagram-breadcrumb-chunking" name="Hierarchy Breadcrumbs Chunking Algorithm">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- HEADER BANNER -->
        <mxCell id="header_banner" value="&lt;div style=&quot;font-size: 18px; font-weight: bold; letter-spacing: 0.5px;&quot;&gt;GIẢI PHẪU THUẬT TOÁN: HIERARCHY BREADCRUMBS CHUNKING (CẮT GẮN ĐƯỜNG DẪN THỨ BẬC)&lt;/div&gt;&lt;div style=&quot;font-size: 12.5px; margin-top: 5px; opacity: 0.9; font-weight: normal;&quot;&gt;Chuyên Đề RAG Study Flow | Bóc Tách Header Markdown (#..###), Cập Nhật Ngăn Xếp Thứ Bậc &amp; Gắn Tiền Tố Ngữ Cảnh&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;">
          <mxGeometry x="40" y="20" width="1320" height="65" as="geometry"/>
        </mxCell>

        <!-- SWIMLANE 1: INPUT & REGEX PARSER -->
        <mxCell id="lane_input" value="BƯỚC 1: ĐẦU VÀO &amp; BỘ LỌC HEADING (INPUT &amp; REGEX PARSER)" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1E293B;startSize=28;rounded=1;arcSize=4;shadow=1;">
          <mxGeometry x="40" y="105" width="370" height="440" as="geometry"/>
        </mxCell>

        <mxCell id="node_input_doc" value="&lt;b&gt;📄 Văn Bản Markdown Gốc (Raw MD)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;Tài liệu cấu trúc phân cấp ngân hàng:&lt;br/&gt;• Dòng tiêu đề: &lt;code&gt;# H1, ## H2, ### H3&lt;/code&gt;&lt;br/&gt;• Dòng nội dung: đoạn văn, danh sách bullet&lt;br/&gt;&lt;i style=&quot;color:#64748B; font-size:10px;&quot;&gt;(Tách thành danh sách dòng: lines = text.split('\n'))&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=11;fontColor=#1E40AF;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="60" y="150" width="330" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="node_regex" value="&lt;b&gt;🔍 Bộ Nhận Diện Heading Regex&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-family:monospace; font-size:11px; background:#F1F5F9; padding:4px; border-radius:4px; color:#0F172A;&quot;&gt;r&quot;^(#{1,6})\s+(.*)&quot;&lt;/div&gt;• &lt;b&gt;Group 1:&lt;/b&gt; Số dấu # &amp;rarr; &lt;span style=&quot;color:#2563EB; font-weight:bold;&quot;&gt;level (1..6)&lt;/span&gt;&lt;br/&gt;• &lt;b&gt;Group 2:&lt;/b&gt; Tiêu đề &amp;rarr; &lt;span style=&quot;color:#D97706; font-weight:bold;&quot;&gt;title text&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#92400E;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="60" y="255" width="330" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="node_state_init" value="&lt;b&gt;🗄️ Khởi Tạo Bộ Nhớ Ngữ Cảnh (State)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• &lt;code&gt;current_headers = {}&lt;/code&gt; &lt;span style=&quot;color:#475569; font-size:10px;&quot;&gt;({cấp: tiêu đề})&lt;/span&gt;&lt;br/&gt;• &lt;code&gt;current_content = []&lt;/code&gt; &lt;span style=&quot;color:#475569; font-size:10px;&quot;&gt;(các dòng văn bản)&lt;/span&gt;&lt;br/&gt;• &lt;code&gt;chunk_id = 0&lt;/code&gt; | &lt;code&gt;chunks = []&lt;/code&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontSize=11;fontColor=#3730A3;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="60" y="370" width="330" height="80" as="geometry"/>
        </mxCell>

        <!-- SWIMLANE 2: STATE MACHINE & STACK PRUNING -->
        <mxCell id="lane_loop" value="BƯỚC 2: MÁY TRẠNG THÁI &amp; CẬP NHẬT NGĂN XẾP (STATE MACHINE &amp; PRUNING)" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0369A1;startSize=28;rounded=1;arcSize=4;shadow=1;">
          <mxGeometry x="430" y="105" width="540" height="440" as="geometry"/>
        </mxCell>

        <mxCell id="node_scan_line" value="&lt;b&gt;Duyệt Từng Dòng&lt;/b&gt;&lt;br/&gt;&lt;code&gt;for line in lines&lt;/code&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;fontColor=#334155;align=center;shadow=1;">
          <mxGeometry x="450" y="150" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="node_check_header" value="&lt;b&gt;Có Phải&lt;br/&gt;Heading?&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(header_match)&lt;/i&gt;" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontColor=#991B1B;fontStyle=1;shadow=1;">
          <mxGeometry x="650" y="135" width="140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="node_handle_header" value="&lt;b&gt;🌳 Cập Nhật Cây Phân Cấp (Header Stack Update)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;1. &lt;b&gt;Đóng gói nội dung cũ:&lt;/b&gt; &lt;code&gt;save_chunk(current_content)&lt;/code&gt;&lt;br/&gt;2. &lt;b&gt;Cắt tỉa nhánh con (Pruning):&lt;/b&gt; Xóa các cấp &lt;code&gt;k &amp;ge; level&lt;/code&gt;&lt;br/&gt;   &lt;i style=&quot;font-size:10px; color:#64748B;&quot;&gt;(Gặp H2 mới &amp;rarr; Xóa H2, H3 cũ để không bị nhiễm bẩn ngữ cảnh)&lt;/i&gt;&lt;br/&gt;3. &lt;b&gt;Ghi nhận cấp mới:&lt;/b&gt; &lt;code&gt;current_headers[level] = title&lt;/code&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=11;fontColor=#78350F;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="450" y="235" width="500" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="node_handle_content" value="&lt;b&gt;📝 Tích Lũy Dòng Nội Dung &amp; Kiểm Tra Kích Thước&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• Nếu dòng không rỗng: &lt;code&gt;temp = current_content + [line]&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Kiểm tra ngưỡng:&lt;/b&gt; Nếu &lt;code&gt;len(temp) &amp;gt; max_chunk_size&lt;/code&gt;:&lt;br/&gt;  &amp;rarr; Gọi &lt;code&gt;save_chunk()&lt;/code&gt; lưu khối hiện tại &amp;amp; bắt đầu chunk mới bằng &lt;code&gt;[line]&lt;/code&gt;&lt;br/&gt;• Nếu chưa vượt: tiếp tục gom vào &lt;code&gt;current_content.append(line)&lt;/code&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=11;fontColor=#155E75;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="450" y="345" width="500" height="90" as="geometry"/>
        </mxCell>

        <!-- SWIMLANE 3: ENRICHMENT & EMIT -->
        <mxCell id="lane_output" value="BƯỚC 3: ĐÓNG GÓI CHUNK CÓ TIỀN TỐ (BREADCRUMB ENRICHMENT)" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#059669;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#047857;startSize=28;rounded=1;arcSize=4;shadow=1;">
          <mxGeometry x="990" y="105" width="370" height="440" as="geometry"/>
        </mxCell>

        <mxCell id="node_gen_crumb" value="&lt;b&gt;🔗 Tạo Chuỗi Breadcrumb (Trail)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:10.5px; font-family:monospace; background:#ECFDF5; padding:5px; border-radius:4px; color:#065F46;&quot;&gt;levels = sorted(current_headers.keys())&lt;br/&gt;breadcrumb = &quot; &gt; &quot;.join(headers[l])&lt;/div&gt;&lt;div style=&quot;font-size:10px; color:#047857; margin-top:4px;&quot;&gt;Ví dụ: &lt;i&gt;&quot;Bảo hiểm FWD &gt; Sản phẩm &gt; Gói Vững ước mơ&quot;&lt;/i&gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=1.5;fontSize=11;fontColor=#166534;align=left;spacingLeft=8;shadow=1;">
          <mxGeometry x="1010" y="150" width="330" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="node_prepend" value="&lt;b&gt;🏷️ Ghép Tiền Tố Ngữ Cảnh Vào Nội Dung&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-family:monospace; font-size:11px; background:#F8FAFC; padding:4px; border:1px dashed #059669; border-radius:4px;&quot;&gt;full_content = f&quot;[{breadcrumb}]\n{text}&quot;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px; color:#334155; margin-top:4px;&quot;&gt;Đưa trọn vẹn ngữ cảnh phân cấp vào Embedding Vector và LLM Context Window!&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#065F46;align=left;spacingLeft=8;shadow=1;">
          <mxGeometry x="1010" y="255" width="330" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="node_emit_chunk" value="&lt;b&gt;📦 Sản Phẩm Hoàn Chỉnh (Enriched Chunk)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;code&gt;chunk = {&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;chunk_id&quot;: 0,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;breadcrumb&quot;: &quot;FWD &gt; Vững ước mơ&quot;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;content&quot;: &quot;[Breadcrumb]\nNội dung...&quot;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;source&quot;: &quot;bao_hiem_fwd.md&quot;&lt;br/&gt;}&lt;/code&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontSize=10.5;fontColor=#1E293B;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="1010" y="365" width="330" height="105" as="geometry"/>
        </mxCell>

        <!-- SWIMLANE 4: BANKING REAL CASE STUDY & COMPARISON -->
        <mxCell id="lane_compare" value="BƯỚC 4: TÁC ĐỘNG NGHIỆP VỤ NGÂN HÀNG THỰC TẾ &amp; SO SÁNH TRỰC QUAN" vertex="1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1E293B;startSize=28;rounded=1;arcSize=4;shadow=1;">
          <mxGeometry x="40" y="565" width="1320" height="360" as="geometry"/>
        </mxCell>

        <!-- SUB BOX 1: INPUT MD -->
        <mxCell id="box_md_sample" value="&lt;b&gt;📄 Văn Bản Ngân Hàng Gốc (Vietcombank MD):&lt;/b&gt;&lt;hr style=&quot;margin:3px 0;&quot;/&gt;&lt;div style=&quot;font-family:monospace; font-size:10px; color:#1E293B; line-height:1.4;&quot;&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;# DANH MỤC BẢO HIỂM FWD LIÊN KẾT VCB&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color:#D97706;&quot;&gt;## 1. SẢN PHẨM NHÂN THỌ &amp; TÍCH LŨY&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color:#059669;&quot;&gt;### 1.1. Gói FWD Vững Ước Mơ&lt;/b&gt;&lt;br/&gt;• Quyền lợi: Bảo vệ 300% Số tiền bảo hiểm.&lt;br/&gt;• Thời hạn hợp đồng: Đến năm 80 hoặc 99 tuổi.&lt;br/&gt;• Thời hạn đóng phí: 10, 15, 20 năm.&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color:#059669;&quot;&gt;### 1.2. Gói FWD Nâng Tầm Vị Thế&lt;/b&gt;&lt;br/&gt;• Dành riêng cho khách hàng VCB Priority...&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="60" y="610" width="370" height="290" as="geometry"/>
        </mxCell>

        <!-- SUB BOX 2: CHUNK TRUYỀN THỐNG (LỖI NGỮ CẢNH) -->
        <mxCell id="box_chunk_bad" value="&lt;b style=&quot;color:#DC2626; font-size:12px;&quot;&gt;❌ CHUNKING TRUYỀN THỐNG (MẤT NGỮ CẢNH)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-family:monospace; font-size:10.5px; background:#FEF2F2; padding:6px; border:1px solid #FCA5A5; border-radius:4px; color:#7F1D1D;&quot;&gt;&quot;• Quyền lợi: Bảo vệ 300% Số tiền bảo hiểm.&lt;br/&gt;• Thời hạn hợp đồng: Đến năm 80 hoặc 99 tuổi.&lt;br/&gt;• Thời hạn đóng phí: 10, 15, 20 năm.&quot;&lt;/div&gt;&lt;br/&gt;&lt;b style=&quot;color:#991B1B;&quot;&gt;⚠️ HẬU QUẢ TẠI HỆ THỐNG RAG:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;User hỏi:&lt;/b&gt; &lt;i&gt;&quot;Quyền lợi 300% bảo vệ là của gói bảo hiểm nào?&quot;&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;Retriever:&lt;/b&gt; Vector đoạn này không chứa từ &lt;i&gt;&quot;FWD&quot;&lt;/i&gt; hay &lt;i&gt;&quot;Vững ước mơ&quot;&lt;/i&gt; &amp;rarr; Điểm tương đồng rất thấp!&lt;br/&gt;• &lt;b&gt;LLM:&lt;/b&gt; Đọc vào đoạn trích không biết là của bảo hiểm nào &amp;rarr; &lt;span style=&quot;color:#B91C1C; font-weight:bold;&quot;&gt;Sinh ảo giác (Hallucination) hoặc từ chối trả lời!&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#EF4444;strokeWidth=2;fontSize=10.5;fontColor=#7F1D1D;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="460" y="610" width="410" height="290" as="geometry"/>
        </mxCell>

        <!-- SUB BOX 3: CHUNK BREADCRUMBS (HOÀN HẢO) -->
        <mxCell id="box_chunk_good" value="&lt;b style=&quot;color:#059669; font-size:12px;&quot;&gt;✅ HIERARCHY BREADCRUMBS CHUNKING (CHUẨN 100%)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-family:monospace; font-size:10px; background:#ECFDF5; padding:6px; border:1px solid #86EFAC; border-radius:4px; color:#064E3B;&quot;&gt;&lt;b style=&quot;color:#047857;&quot;&gt;[DANH MỤC BẢO HIỂM FWD &gt; SẢN PHẨM NHÂN THỌ &gt; Gói FWD Vững Ước Mơ]&lt;/b&gt;&lt;br/&gt;• Quyền lợi: Bảo vệ 300% Số tiền bảo hiểm.&lt;br/&gt;• Thời hạn hợp đồng: Đến năm 80 hoặc 99 tuổi.&lt;br/&gt;• Thời hạn đóng phí: 10, 15, 20 năm.&lt;/div&gt;&lt;br/&gt;&lt;b style=&quot;color:#065F46;&quot;&gt;🎯 LỢI ÍCH VƯỢT TRỘI CHO NGÂN HÀNG:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Dense Retrieval:&lt;/b&gt; Vector chunk mang đầy đủ tên công ty, dòng sản phẩm và tên gói.&lt;br/&gt;• &lt;b&gt;LLM Generation:&lt;/b&gt; Mô hình nắm bắt chính xác 100% ngữ cảnh phân cấp: &lt;i&gt;&quot;Gói FWD Vững Ước Mơ thuộc bảo hiểm nhân thọ FWD liên kết Vietcombank có quyền lợi bảo vệ 300%...&quot;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=2;fontSize=10.5;fontColor=#064E3B;align=left;spacingLeft=10;shadow=1;">
          <mxGeometry x="895" y="610" width="445" height="290" as="geometry"/>
        </mxCell>

        <!-- EDGES / CONNECTORS -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="node_input_doc" target="node_regex">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1_label" value="Duyệt từng dòng" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#1E40AF;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="node_regex" target="node_scan_line">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="302"/>
              <mxPoint x="410" y="175"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="node_scan_line" target="node_check_header">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="node_check_header" target="node_handle_header">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4_label" value="Đúng (Khớp #{1..6})" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#991B1B;fontStyle=1;" vertex="1" connectable="0" parent="e4">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0891B2;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="node_check_header" target="node_handle_content">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="175"/>
              <mxPoint x="840" y="390"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5_label" value="Sai (Dòng văn bản thường)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#155E75;fontStyle=1;" vertex="1" connectable="0" parent="e5">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="node_handle_header" target="node_gen_crumb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="970" y="282"/>
              <mxPoint x="970" y="195"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6_label" value="Lưu chunk cũ &amp;amp; Cập nhật Stack" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#78350F;" vertex="1" connectable="0" parent="e6">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset"/>
